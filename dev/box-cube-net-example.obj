# Card box 3D model for TTS
# Dimensions: 2cm (width) x 5cm (length) x 3.5cm (height)
# UV mapping for cube net texture layout:
#                  top
#     left side | front | right side | back
#                 bottom

g card_box

# Vertices (8 corners of the box)
# X-axis: width (2cm), Y-axis: length (5cm), Z-axis: height (3.5cm)
v -1.000000 -2.500000 1.750000  # 1: front-bottom-left
v 1.000000 -2.500000 1.750000   # 2: front-bottom-right
v -1.000000 2.500000 1.750000   # 3: front-top-left
v 1.000000 2.500000 1.750000    # 4: front-top-right
v -1.000000 2.500000 -1.750000  # 5: back-top-left
v 1.000000 2.500000 -1.750000   # 6: back-top-right
v -1.000000 -2.500000 -1.750000 # 7: back-bottom-left
v 1.000000 -2.500000 -1.750000  # 8: back-bottom-right

# UV coordinates for cube net layout
# Texture size: 2048x1536 (4 faces wide x 3 faces tall)
# Face size: 512x512

# Front face UVs (row 1, col 1: x=[0.25, 0.5], y=[0.333, 0.667])
vt 0.250000 0.333333  # 1: bottom-left
vt 0.500000 0.333333  # 2: bottom-right
vt 0.500000 0.666667  # 3: top-right
vt 0.250000 0.666667  # 4: top-left

# Top face UVs (row 2, col 1: x=[0.25, 0.5], y=[0.667, 1.0])
vt 0.250000 0.666667  # 5: bottom-left
vt 0.500000 0.666667  # 6: bottom-right
vt 0.500000 1.000000  # 7: top-right
vt 0.250000 1.000000  # 8: top-left

# Back face UVs (row 1, col 3: x=[0.75, 1.0], y=[0.333, 0.667])
vt 0.750000 0.333333  # 9: bottom-left
vt 1.000000 0.333333  # 10: bottom-right
vt 1.000000 0.666667  # 11: top-right
vt 0.750000 0.666667  # 12: top-left

# Bottom face UVs (row 0, col 1: x=[0.25, 0.5], y=[0.0, 0.333])
vt 0.250000 0.000000  # 13: bottom-left
vt 0.500000 0.000000  # 14: bottom-right
vt 0.500000 0.333333  # 15: top-right
vt 0.250000 0.333333  # 16: top-left

# Right face UVs (row 1, col 2: x=[0.5, 0.75], y=[0.333, 0.667])
vt 0.500000 0.333333  # 17: bottom-left
vt 0.750000 0.333333  # 18: bottom-right
vt 0.750000 0.666667  # 19: top-right
vt 0.500000 0.666667  # 20: top-left

# Left face UVs (row 1, col 0: x=[0.0, 0.25], y=[0.333, 0.667])
vt 0.000000 0.333333  # 21: bottom-left
vt 0.250000 0.333333  # 22: bottom-right
vt 0.250000 0.666667  # 23: top-right
vt 0.000000 0.666667  # 24: top-left

# Normals
vn 0.000000 0.000000 1.000000   # Front
vn 0.000000 1.000000 0.000000   # Top
vn 0.000000 0.000000 -1.000000  # Back
vn 0.000000 -1.000000 0.000000  # Bottom
vn 1.000000 0.000000 0.000000   # Right
vn -1.000000 0.000000 0.000000  # Left

s off

# Faces (vertex/uv/normal)
# Front face (vertices 1,2,4,3)
f 1/1/1 2/2/1 4/3/1 3/4/1

# Top face (vertices 3,4,6,5)
f 3/5/2 4/6/2 6/7/2 5/8/2

# Back face (vertices 5,6,8,7)
f 5/9/3 6/10/3 8/11/3 7/12/3

# Bottom face (vertices 7,8,2,1)
f 7/13/4 8/14/4 2/15/4 1/16/4

# Right face (vertices 2,8,6,4)
f 2/17/5 8/18/5 6/19/5 4/20/5

# Left face (vertices 7,1,3,5)
f 7/21/6 1/22/6 3/23/6 5/24/6
