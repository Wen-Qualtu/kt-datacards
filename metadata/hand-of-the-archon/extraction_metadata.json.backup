      "devious-scheme": {
        "card_name": "devious-scheme",
        "page_num": 0,
        "extraction": {
          "source_pdf": "C:\\kt-datacards\\processed\\hand-of-the-archon\\hand-of-the-archon-firefight-ploys.pdf",
          "extracted_at": "2026-01-25T17:15:21.429936",
          "full_text": "Schemers all, the Drukhari are used to staying one step ahead of their opponents and confounding their every move. Use this firefight ploy after an opponent uses a firefight ploy (excluding one that costs 0CP). The next time they would use that ploy, they must spend 1 additional CP to do so (at which point this effect ends). You cannot use this ploy again during the battle until its effect has ended.",
          "text_extracted": true,
          "name_confidence": "high"
