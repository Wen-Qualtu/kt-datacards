    "strategy-ploys": {
      "mission-tactics": {
        "card_name": "mission-tactics",
        "page_num": 0,
        "extraction": {
          "source_pdf": "C:\\kt-datacards\\processed\\deathwatch\\deathwatch-strategy-ploys.pdf",
          "extracted_at": "2026-01-25T17:15:18.391450",
          "full_text": "Through collated strategic data and hard-won combat experience, the Deathwatch possess the tactics to combat almost any foe. Select Conceal or Engage. Whenever a friendly DEATHWATCH  operative is shooting against or fighting against an enemy operative that has that order, that friendly operative’s weapons have the Balanced weapon rule.",
          "text_extracted": true,
          "name_confidence": "high"
        },
        "output": {
          "front_image": "C:\\kt-datacards\\output_v2\\imperium\\deathwatch\\strategy-ploys\\deathwatch-strategy-ploys-front.jpg",
          "back_image": null,
          "image_format": "jpg",
          "image_dpi": 300
        }
      },
      "the-long-vigil": {
        "card_name": "the-long-vigil",
        "page_num": 0,
        "extraction": {
          "source_pdf": "C:\\kt-datacards\\processed\\deathwatch\\deathwatch-strategy-ploys.pdf",
          "extracted_at": "2026-01-25T17:15:18.391469",
          "full_text": "The Deathwatch guard some of the most dangerous stretches of the Imperium. Their vow to stand firm is at the heart of their vigil; they will see their foes dead before they abandon the Emperor’s realm. Whenever an operative is shooting a friendly DEATHWATCH  operative that’s within your territory, you can re-roll one of your defence dice.",
          "text_extracted": true,
          "name_confidence": "high"
        },
        "output": {
          "front_image": "C:\\kt-datacards\\output_v2\\imperium\\deathwatch\\strategy-ploys\\deathwatch-strategy-ploys-front.jpg",
          "back_image": null,
          "image_format": "jpg",
          "image_dpi": 300
        }
      },
      "the-shield-that-slays": {
        "card_name": "the-shield-that-slays",
        "page_num": 0,
        "extraction": {
          "source_pdf": "C:\\kt-datacards\\processed\\deathwatch\\deathwatch-strategy-ploys.pdf",
          "extracted_at": "2026-01-25T17:15:18.391482",
          "full_text": "To enter the infested holds of the xenos is to be assailed by the most inhuman of abominations and technology, a foulness that the Deathwatch are trained to resist. Whenever a friendly DEATHWATCH  operative is within your opponent’s territory, Normal and Critical Dmg of 4 or more inflicts 1 less damage on it.",
          "text_extracted": true,
          "name_confidence": "high"
        },
        "output": {
          "front_image": "C:\\kt-datacards\\output_v2\\imperium\\deathwatch\\strategy-ploys\\deathwatch-strategy-ploys-front.jpg",
          "back_image": null,
          "image_format": "jpg",
          "image_dpi": 300
        }
      },
      "and-they-shall-know-no-fear": {
        "card_name": "and-they-shall-know-no-fear",
        "page_num": 0,
        "extraction": {
          "source_pdf": "C:\\kt-datacards\\processed\\deathwatch\\deathwatch-strategy-ploys.pdf",
          "extracted_at": "2026-01-25T17:15:18.391494",
          "full_text": "Space Marines possess extraordinary courage and are utterly unflinching in the face of terrifying horrors and overwhelming odds. You can ignore any changes to the stats of friendly DEATHWATCH  operatives from being injured (including their weapons’ stats).",
          "text_extracted": true,
          "name_confidence": "high"
        },
        "output": {
          "front_image": "C:\\kt-datacards\\output_v2\\imperium\\deathwatch\\strategy-ploys\\deathwatch-strategy-ploys-front.jpg",
